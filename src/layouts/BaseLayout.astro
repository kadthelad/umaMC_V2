---
import { getDatabases, getSelectedDb } from "../lib/database";
import { Font } from "astro:assets";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
const { isLoggedIn, username } = Astro.locals;
import { actions } from "astro:actions";

const databases = getDatabases();
const selectedDb = getSelectedDb(Astro.cookies.get("selectedDb")?.value, databases);
const websiteVersion = "1.3";
---

<html lang="en">
	<head>
        <title>UmaMC</title>
        <link rel="icon" type="image/x-icon" href="/images/NEICHA.ico">
		<ClientRouter />
		<Font cssVariable="--FontAsap" preload />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" charset="utf-8">
	</head>
    <body>
        <header>
            <select id="db-select" transition:persist>
                {databases.map((db) => (
                    <option value={db} selected={db === selectedDb}>{db}</option>
                ))}
            </select>
            <a href="/" class="clickable_image"><img src="/images/NEICHA.png" alt="Neicha"></a>
            <a href="/horseviewer">Horse Viewer</a>
            <a href="/world">World</a>
            <a href="/breeding">Breeding</a>

            {isLoggedIn ? (
                <div class="login_status">
                    <span>Logged in as {username}</span> <br>
                    <img src="/images/Hishiama_Goal.png" alt="Hishiama Goal">
                    <form id="logout-form" method="POST" action={actions.logout}>
                        <button type="submit" class="text_a">Log out</button>
                    </form>
                </div>
            ) : (
                <a href="/login" class="login_a">Log in to edit</a>
            )}
        </header>
        <main><slot /></main>
        <footer>
            <div class="dev_info">
                <h3>Kad© 2026 -- Website version: { websiteVersion }</h3> <br>
                <h3>Contact: kadirekici1268@gmail.com</h3> <br>
            </div>
            <nav>
                <a href="/">Home</a><a href="">Confidentiality Policy</a><a href="">Cookies Policy</a><a href="">General Conditions</a>
            </nav>
        </footer>
        <script>
			document.getElementById("db-select")?.addEventListener("change", (e) => {
				const value = (e.target as HTMLSelectElement).value;
				document.cookie = `selectedDb=${value}; path=/; max-age=31536000`;
				window.location.reload();
			});

            import { actions } from "astro:actions";

            document.addEventListener("astro:page-load", () => {
                const form = document.getElementById("logout-form") as HTMLFormElement | null;
                form?.addEventListener("submit", async (e) => {
                    e.preventDefault();
                    await actions.logout(new FormData(form));
                    window.location.reload();
                });
            });
		</script>
    </body>
</html>

<style>
    .login_a {
        color: brown;
        outline-color: brown;
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
    }

    .login_a:active {
        animation: none;
    }

    .login_status {
        font-size: small;
        position: absolute;
        color: aliceblue;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
    }

    .text_a {
        background-color: rgba(0, 0, 0, 0);
        border-style: none;
        color: darkgray;
        text-decoration: underline;
    }
</style>
